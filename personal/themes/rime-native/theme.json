{
  "extends": "glass",
  "schema": 1,
  "meta": { "id": "rime-native", "name": "Rime 原生" },

  // 对齐 macOS 自带简体拼音：整条胶囊、胶囊高亮、末尾分隔线加向下箭头；量自原生输入法 2x 截图
  "variables": {
    "accent": { "light": "#0060ff", "dark": "#0b6bff" },
    "diff": { "light": "#1d1d1f", "dark": "#f5f5f7" },
    "text": { "light": "#1d1d1f", "dark": "#ffffffd9" },
    "hl_text": "#ffffff",
    "hl_gloss": "#ffffffd9",
    "hl_faint": "#ffffffcc",
    "hl_diff": "#ffffff"
  },

  "text": {
    // 原生 CoreText 字体平滑会把笔画外扩，线性覆盖率画出来偏细；按截图墨量对齐。文字色是系统 labelColor（85% 不透明）
    "gamma": { "light": 0.5, "dark": 0.3 },
    "family": ["PingFang SC", "system"],
    "styles": {
      "candidate": { "size": 16, "line_height": 22 },
      "annotation": { "size": 12, "line_height": 15 },
      "index": { "size": 8.5, "line_height": 11, "weight": "medium" }
    }
  },

  "components": {
    "item": {
      "type": "frame", "padding": [0, 7.5, 2, 4],
      "children": [
        { "type": "frame", "id": "highlight", "transition": { "duration": 120, "easing": "ease-out" },
          "when": "highlighted", "position": "absolute", "inset": [0, 0, 0, 0], "fill": "@accent", "radius": 12 },
        { "type": "text", "bind": "index", "font": "index", "margin": [6.5, 4, 0, 0], "min_width": 6,
          "color": { "if": "highlighted", "then": "@hl_faint", "else": "@faint" } },
        { "type": "use", "component": "word" }
      ]
    },

    "native-pager": {
      "type": "frame", "when": "page", "margin": [0, 0, 0, "auto"], "align_self": "center",
      "children": [
        { "type": "frame", "width": 1, "height": 20, "fill": "@divider", "margin": [0, 0, 0, 6], "align_self": "center" },
        // 跟着玻璃深浅变不了色，取两种外观下都看得清的系统灰
        { "type": "frame", "width": 12, "height": 12, "margin": [0, 7, 0, 9], "align_self": "center",
          "action": "next_page", "fill": { "image": "images/chevron-down.svg" } }
      ]
    }
  },

  "windows": {
    "vertical": { "radius": 15.5 },
    "horizontal": {
      "type": "frame", "direction": "column", "padding": 2,
      "fill": "@surface", "radius": 13.5, "border": { "width": 0, "color": "@edge" },
      "effects": [],
      "children": [
        { "type": "use", "component": "top_line", "margin": [0, 12, 0, 12] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "gap": 3,
          "children": [
            { "type": "repeat", "bind": "candidates", "component": "item" },
            { "type": "use", "component": "native-pager" }
          ] }
      ]
    }
  }
}
